from ssbrc.fighters import fighters, get_color

from itertools import chain

gold = False
for fighter in fighters:
	n = 1
	function f'ssbrc:game/entity/player/fighter/{fighter}/menu/skin/trigger':
		for skin in chain(['default', 'gold'], fighters[fighter]['skins']):
			if skin == 'gold':
				if gold == True:
					continue
				else:
					gold = True

			if score @s menu matches n return run function ssbrc:game/entity/player/fighter/_logic/select/skin {'fighter': fighter, 'skin': skin, 'color': get_color(fighter, skin)}
			n += 2
