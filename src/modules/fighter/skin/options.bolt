from ssbrc.fighters import fighters, has_forms, forms_isolated_to, gendered_skin_menu, get_color_wrapper, skin_options

from itertools import chain

for fighter in fighters:
	n = 1
	function f'ssbrc:game/fighter/{fighter}/menu/skin/options':
		dialog show @s {
			type: "minecraft:multi_action",
			title: {
				text: "Skins",
				color: "gold"
			},
			body: {
				type: "minecraft:plain_message",
				contents: {
					text: "Click a skin to equip it! Click the disk icon next to it to set a skin as default.",
					color: "light_purple"
				}
			},
			inputs: [],
			can_close_with_escape: 1,
			after_action: "close",
			pause: 0,
			exit_action: {
				label: "",
				action: {
					type: "minecraft:run_command",
					command: "trigger menu set -1"
				}
			},
			actions: skin_options()
		}

		function ssbrc:game/fighter/_logic/menu/skin_options
