from ssbrc.death_effects import death_effects, death_effect_storage

from ssbrc.ui import chest_map

from itertools import chain

import math

function ssbrc:game/data/registry/death_effect:
	data modify storage ssbrc:data death_effect set value death_effect_storage()

for effect in death_effects:
	advancement f'ssbrc:death_effect/{effect}' {
		"parent": f'ssbrc:unlock',
		"criteria": {
			"default": {
				"trigger": "minecraft:impossible"
			}
		}
	}

path = 'shop/pages/death_effect'
pages = math.ceil(len(death_effects) / len(chest_map))
for prev in range(pages):
	this = prev + 1
	next = this + 1

	function f'ssbrc:{path}/{this}':
		data modify storage ssbrc:temp cache.ui merge value {'path': f'{path}/{this}', 'ui_color': 'red'}
		function ssbrc:game/ui/reset with storage ssbrc:temp cache.ui

		function ssbrc:game/ui/buttons/placeholder/get {'slot': 0}
		if prev == 0:
			function ssbrc:game/ui/buttons/navigator {'path': f'{path}/main', 'type': 'back', 'slot': 9}
		else:
			function ssbrc:game/ui/buttons/navigator {'path': f'{path}/{prev}', 'type': 'back', 'slot': 9}
		function ssbrc:game/ui/buttons/placeholder/get {'slot': 18}

		n = 1
		for effect in list(death_effects.keys())[(prev * 15):(prev * 15) + 15]:
			function ssbrc:shop/buttons/death_effect/get {'id': effect, 'slot': chest_map[n]}
			n += 1

		function ssbrc:game/ui/buttons/placeholder/get {'slot': 8}
		if prev == (pages - 1):
			function ssbrc:game/ui/buttons/placeholder/get {'slot': 17}
		else:
			function ssbrc:game/ui/buttons/navigator {'path': f'{path}/{next}', 'type': 'forward', 'slot': 17}
		function ssbrc:game/ui/buttons/placeholder/get {'slot': 26}
