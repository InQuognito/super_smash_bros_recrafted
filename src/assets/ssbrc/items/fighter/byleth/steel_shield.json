{
	"model": {
		"type": "minecraft:select",
		"property": "minecraft:custom_model_data",
		"cases": [
			{
				"when": "gold",
				"model": {
					"type": "minecraft:condition",
					"property": "minecraft:using_item",
					"on_false": {
						"type": "minecraft:model",
						"model": "ssbrc:fighter/byleth/item/steel_shield/gold"
					},
					"on_true": {
						"type": "minecraft:model",
						"model": "ssbrc:fighter/byleth/item/steel_shield/gold"
					}
				}
			}
		],
		"fallback": {
			"type": "minecraft:condition",
			"property": "minecraft:using_item",
			"on_false": {
				"type": "minecraft:model",
				"model": "ssbrc:fighter/byleth/item/steel_shield/default"
			},
			"on_true": {
				"type": "minecraft:model",
				"model": "ssbrc:fighter/byleth/item/steel_shield/default"
			}
		},
		"transformation": {
			"left_rotation": [
				0,
				0,
				0,
				1
			],
			"right_rotation": [
				0,
				0,
				0,
				1
			],
			"scale": [
				1,
				-1,
				-1
			],
			"translation": [
				0,
				0,
				0
			]
		}
	},
	"hand_animation_on_swap": false
}
